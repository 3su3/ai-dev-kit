#!/usr/bin/env python3
"""計画の「修正対象」と、実際の差分を**集合で**突き合わせる。

**記憶から「計画との差: なし」と書かせないための道具。**
実装したエージェントは計画の方を覚えているので、ずれたときほど
「計画どおりにやったつもり」で書く。読む人が一番見たいものが落ちる。

    bin/plan-vs-diff <計画のパス> [--base origin/main]

終了コード: 差があれば 1。無ければ 0。
"""
import argparse
import re
import subprocess
import sys
from pathlib import Path


def changed(base):
    """**3点比較で取る。** `{base}..HEAD` だと分岐後に base 側へ入った他人の変更まで
    並び、こちらの変更として数えられる（実測で 6 件のはずが 19 件になった）。"""
    r = subprocess.run(["git", "diff", "--name-only", f"{base}...HEAD"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"git diff が失敗した（base={base}）: {r.stderr.strip()[:200]}")
    return {x for x in r.stdout.split() if x}


def uncommitted():
    """作業ツリーの変更（未追跡を含む）。**取れなければ None。**"""
    # **`-uall` が要る。** 既定だと未追跡ディレクトリを `sub/` の1行に畳むため、
    # 中のファイルが見えない。ディレクトリごと巻き込んでも1件にしか数えられない。
    r = subprocess.run(["git", "status", "--porcelain", "-uall"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    out = set()
    for line in r.stdout.splitlines():
        if not line.strip():
            continue
        path = line[3:].strip().strip('"')
        # リネームは "旧 -> 新"。新しい方を採る
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        out.add(path)
    return out


PATHS = re.compile(r"[`\s(]([\w./-]+\.\w{1,6})[`\s),]")
# `- **対象**: \`path\`` の形。見出しが無い計画はこちらで拾う。
TARGET_LINE = re.compile(r"^\s*[-*]?\s*\*\*対象\*\*\s*[:：]\s*(.+)$", re.M)


def _paths(text):
    found = set(PATHS.findall(text + " "))
    return {f for f in found if "/" in f or f.count(".") == 1}


def planned(path):
    """計画が挙げている修正対象。**どこから読んだかも返す。**

    読み方は2つ。**どちらで読んだかを出力に出す**ので、基準が分からないまま
    件数だけを見ることにならない。

      1. `## 修正対象` の節（雛形の形）
      2. `**対象**:` の行（タスクごとに対象を書く形）

    2 を足したのは、雛形が Kiro に届いていなかった時期の計画が 1 を持たないため。
    **計画側に節を足すと、タスクごとの `**対象**:` と二重持ちになる**（古い方が
    生き残る形）。読む側を広げるほうを採った。

    どちらも無ければ止める。**0 件を「差なし」として扱わない。**
    """
    body = Path(path).read_text(encoding="utf-8")
    m = re.search(r"^#{1,3}\s*\d*\.?\s*修正対象\s*$", body, re.M)
    if m:
        rest = body[m.end():]
        nxt = re.search(r"^#{1,3}\s", rest, re.M)
        return _paths(rest[:nxt.start()] if nxt else rest), "## 修正対象 の節"
    lines = TARGET_LINE.findall(body)
    if lines:
        out = set()
        for ln in lines:
            out |= _paths(ln)
        return out, f"**対象**: の行 {len(lines)} 本"
    sys.exit(f"修正対象を読み取れない: {path}\n"
             "  `## 修正対象` の節も `**対象**:` の行も無い。\n"
             "  計画側を直すかこの道具を直す。**目で数えて済ませない。**")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("plan")
    ap.add_argument("--base", default="origin/main")
    ap.add_argument("--include-uncommitted", action="store_true",
                    help="作業ツリーの変更も差分に数える（まだコミットしていない段階用）")
    a = ap.parse_args()

    # **未コミットの変更は差分に出ない。** 気づかないと、実装済みのものが
    # 「計画にあって未実装」として並び、**逆向きの偽の警告**になる。
    dirty = uncommitted()
    if dirty is None:
        sys.exit("git status が取れない。**取れないことを「変更なし」と同じに扱わない。**")

    want, source = planned(a.plan)
    got = changed(a.base)
    if dirty and not a.include_uncommitted:
        # **不完全な材料で本文を出さない。** 以前はここで警告だけ出して比較を続けて
        # いたため、未コミットで実装済みのものが「計画にあって未実装」として並んだ。
        # 警告は上に出ているのに本文が逆を言うので、本文のほうが信じられる。
        sys.exit(f"!! 未コミットの変更が {len(dirty)} 件ある。**この出力には含まれない。**\n"
                 "   このまま比べると、実装済みのものが「計画にあって未実装」として並ぶ。\n"
                 "   どちらかを選ぶ:\n"
                 "     コミットしてから回す\n"
                 "     --include-uncommitted を付けて、作業ツリーの変更も数える")
    if a.include_uncommitted:
        got = got | dirty
    # **計画そのものは差分から外す。** 計画を書けば必ず変わるので、入れておくと
    # 毎回「計画に無い変更」に並び、本物の巻き込みが埋もれる。
    try:
        rel = str(Path(a.plan).resolve().relative_to(Path.cwd().resolve()))
    except ValueError:
        rel = a.plan
    got -= {rel, a.plan}
    if not want:
        sys.exit("計画から1件も拾えなかった。**0 件を「差なし」として扱わない。**"
                 "\n  見出しの下にパスが書かれているか確認する")

    # **ファイル名だけ書かれた計画行を、差分のパスへ結ぶ。** 結ばないと同じものが
    # 「計画にあって未実装」と「計画に無い変更」の両方に出て、どちらも嘘になる。
    # **一意に決まるときだけ結ぶ。** 同名が複数あるなら決められないので、結ばずに
    # 曖昧だったことを出す。
    by_base = {}
    for g in got:
        by_base.setdefault(g.rsplit("/", 1)[-1], []).append(g)
    resolved, ambiguous = set(), []
    for w in want:
        if "/" in w or w in got:
            resolved.add(w)
            continue
        hits = by_base.get(w, [])
        if len(hits) == 1:
            resolved.add(hits[0])
        else:
            resolved.add(w)
            if len(hits) > 1:
                ambiguous.append((w, sorted(hits)))
    want = resolved

    missing = sorted(want - got)      # 計画にあって未実装
    extra = sorted(got - want)        # 計画に無い変更

    where = f"base={a.base}" + ("＋作業ツリー" if a.include_uncommitted else "")
    print(f"# 計画 {len(want)} 件 / 差分 {len(got)} 件  （{where}）")
    print(f"  計画の読み方: {source}")
    print(f"\n計画にあって未実装 {len(missing)} 件")
    for f in missing:
        print(f"  - {f}")
    print(f"\n計画に無い変更 {len(extra)} 件")
    for f in extra:
        print(f"  + {f}  ← 理由を1行で書く")
    for w, hits in ambiguous:
        print(f"\n!! 計画の `{w}` は名前だけで、同名が {len(hits)} 件ある。結んでいない")
        for h in hits:
            print(f"     {h}")
    if not missing and not extra:
        print("\n一致。**この出力を根拠として報告に書く。**")
    else:
        print("\n**「計画との差: なし」と書かない。** 上の件数と理由を書く。")
    return 1 if (missing or extra) else 0


if __name__ == "__main__":
    sys.exit(main())
