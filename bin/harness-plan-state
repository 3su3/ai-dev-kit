#!/usr/bin/env python3
"""harness-plan-state — plan が済んだかを、PR から機械で見る。

    harness-plan-state <番号> ...        そのチケットの plan の状態
    harness-plan-state --branch <枝>     枝から番号を引いて調べる
    harness-plan-state --json

**plan の完了は、放っておくと機械からは見えない。** 文書を1枚置くだけでは「書いた」と
「済んだ」が区別できず、状態を書き足す運用にしても**その行は凍る**（別リポジトリで実測:
対応する PR がマージされた後も「承認待ち」のまま残った文書が3本あった）。

そこで **plan を PR で出す**。承認がそのまま人の承認になり、マージがそのまま完了の印に
なる。新しい規約を足さずに済み、**マージを見ている側はもう在る**。

plan PR かどうかは**変更パス**で決める。plan だけを足す PR は `issues/` のような場所しか
触らない。この接頭辞は**プロジェクトで違う**ので `--plan-path` で変えられる。
既定を持たせてあるが、**道具に焼き込んでいない**。

返す状態:

    none      plan の PR が見当たらない
    draft     Draft。まだレビュー前
    ready     Ready。**人の承認が要る合図**
    merged    plan 完了
    closed    閉じられた（採用されなかった）
    unknown   **取れなかった。** none と同じ顔にしない

最後が肝。`gh` が落ちている・認証が切れている・ネットワークが無い、を「plan が無い」と
同じに扱うと、**済んでいる plan を未着手として数える**。

**上限で打ち切られたときも `none` と言わない。** 一覧を `--limit` 件しか引かないので、
古い PR は視界の外に出る。実際、上限60では「plan は無い」と出たチケットに、上限300で
Draft の plan PR が在った（2026-11-06 実測）。言い切れるのは「在った」ほうだけ。

**限界: PR が多いリポジトリでは、上限を上げても打ち切られ続ける。** そのときは常に
`unknown` になり、この道具は答えを出せない。`head:` で枝ごとに引けば件数に依らないが、
番号だけからは枝の接頭辞を一意に作れない（`feature/<番号>-` と `feature/redmine<番号>-`
の両方がある）ため、**推測を入れないことを優先してここでは採らない。**
"""
import argparse
import importlib.machinery
import importlib.util
import json
import pathlib
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent
# plan だけを足す PR が触る場所。**プロジェクトで違う**ので既定でしかない。
DEFAULT_PLAN_PATHS = ("issues/",)
# 進んでいる順。1チケットに複数あるときは、一番進んだものを採る。
ORDER = ("merged", "ready", "draft", "closed", "none")


def _resolver():
    loader = importlib.machinery.SourceFileLoader("ticket_of", str(HERE / "harness-ticket-of"))
    spec = importlib.util.spec_from_loader("ticket_of", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def classify(paths, plan_paths):
    """その PR が plan か実装か。**ファイル一覧が空なら unknown**（取れていない）。"""
    if not paths:
        return "unknown"
    return "plan" if all(p.startswith(tuple(plan_paths)) for p in paths) else "impl"


def pr_state(pr):
    """1本の PR の状態。Draft と Ready を分ける（Ready が人の承認の合図）。"""
    s = (pr.get("state") or "").upper()
    if s == "MERGED":
        return "merged"
    if s == "CLOSED":
        return "closed"
    return "draft" if pr.get("isDraft") else "ready"


def plan_state(prs, plan_paths):
    """そのチケットの plan の状態。**1本でも unknown があれば unknown へ倒す。**

    取れていない PR があるのに「plan は無い」と答えると、済んでいるものを
    未着手として数える。分からないことは分からないと出す。
    """
    states = []
    for pr in prs:
        kind = classify([f.get("path", "") for f in pr.get("files", [])], plan_paths)
        if kind == "unknown":
            return "unknown"
        if kind == "plan":
            states.append(pr_state(pr))
    if not states:
        return "none"
    for s in ORDER:
        if s in states:
            return s
    return "none"


def resolve_state(prs, plan_paths, truncated):
    """打ち切りを踏まえた最終判定。

    **上限で打ち切られたなら「無い」と言い切れない。** 見ていないだけかもしれない。
    言い切れるのは「在った」ほうだけなので、`none` のときだけ unknown へ倒す。
    """
    st = plan_state(prs, plan_paths)
    return "unknown" if (st == "none" and truncated) else st


def fetch(repo_args, limit):
    """PR を引く。**取れなければ None**（空リストと区別する）。"""
    cmd = ["gh", "pr", "list", "--state", "all", "--limit", str(limit),
           "--json", "number,state,isDraft,headRefName,files"] + repo_args
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    try:
        rows = json.loads(r.stdout or "[]")
    except json.JSONDecodeError:
        return None
    # **打ち切られたかを呼び出し側へ渡す。** 全部見たのか、上限で止まったのかで
    # 「plan が無い」と言ってよいかが変わる。
    return (rows, len(rows) >= limit)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("tickets", nargs="*", type=int)
    ap.add_argument("--branch", help="枝から番号を引く")
    ap.add_argument("--plan-path", action="append", default=None,
                    help=f"plan PR だけが触る接頭辞。既定 {', '.join(DEFAULT_PLAN_PATHS)}")
    ap.add_argument("--repo", help="対象リポジトリ（gh の --repo）")
    ap.add_argument("--limit", type=int, default=100)
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()

    plan_paths = a.plan_path or list(DEFAULT_PLAN_PATHS)
    tickets = list(a.tickets)
    if a.branch:
        verdict, n = _resolver().resolve(a.branch)
        if verdict != "ticket":
            print(f"harness-plan-state: 枝から番号を引けない（{verdict}）: {a.branch}",
                  file=sys.stderr)
            return 1
        tickets.append(n)
    if not tickets:
        print("harness-plan-state: 番号か --branch が要る", file=sys.stderr)
        return 1

    got = fetch(["--repo", a.repo] if a.repo else [], a.limit)
    if got is None:
        # **取れなかった。** none と同じ顔にしない
        rows = [{"ticket": t, "state": "unknown", "prs": []} for t in tickets]
    else:
        prs, truncated = got
        resolve = _resolver().resolve
        rows = []
        for t in tickets:
            mine = [p for p in prs if resolve(p.get("headRefName", ""))[1] == t]
            st = resolve_state(mine, plan_paths, truncated)
            rows.append({"ticket": t, "state": st,
                         "prs": [p["number"] for p in mine]})

    if a.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        for r in rows:
            pr = ",".join(f"#{n}" for n in r["prs"]) or "-"
            print(f"{r['state']} {r['ticket']} {pr}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
